[
  {
    "id": "g-001",
    "level": 1,
    "pattern": "-입니다 / -입니까",
    "ja": "〜です / 〜ですか",
    "explanation": "名詞につけるかしこまった「です」。疑問は「-입니까?」。",
    "examples": [
      {
        "ko": "저는 학생입니다.",
        "ja": "私は学生です。"
      },
      {
        "ko": "이것은 책입니다.",
        "ja": "これは本です。"
      },
      {
        "ko": "회사원입니까?",
        "ja": "会社員ですか？"
      }
    ]
  },
  {
    "id": "g-002",
    "level": 1,
    "pattern": "-이에요 / -예요",
    "ja": "〜です（やわらかい）",
    "explanation": "日常でよく使う「です」。パッチムあり→이에요、なし→예요。",
    "examples": [
      {
        "ko": "저는 일본 사람이에요.",
        "ja": "私は日本人です。"
      },
      {
        "ko": "이거 제 가방이에요.",
        "ja": "これ私のカバンです。"
      },
      {
        "ko": "제 친구예요.",
        "ja": "私の友達です。"
      }
    ]
  },
  {
    "id": "g-003",
    "level": 1,
    "pattern": "-이 / -가",
    "ja": "〜が",
    "explanation": "主語を表す助詞。パッチムあり→이、なし→가。",
    "examples": [
      {
        "ko": "날씨가 좋아요.",
        "ja": "天気がいいです。"
      },
      {
        "ko": "사람이 많아요.",
        "ja": "人が多いです。"
      },
      {
        "ko": "누가 왔어요?",
        "ja": "誰が来ましたか？"
      }
    ]
  },
  {
    "id": "g-004",
    "level": 1,
    "pattern": "-은 / -는",
    "ja": "〜は",
    "explanation": "話題や対比を表す助詞。パッチムあり→은、なし→는。",
    "examples": [
      {
        "ko": "저는 유키예요.",
        "ja": "私はユキです。"
      },
      {
        "ko": "오늘은 바빠요.",
        "ja": "今日は忙しいです。"
      },
      {
        "ko": "이 책은 재미있어요.",
        "ja": "この本は面白いです。"
      }
    ]
  },
  {
    "id": "g-005",
    "level": 1,
    "pattern": "-을 / -를",
    "ja": "〜を",
    "explanation": "目的語を表す助詞。パッチムあり→을、なし→를。",
    "examples": [
      {
        "ko": "밥을 먹어요.",
        "ja": "ご飯を食べます。"
      },
      {
        "ko": "커피를 마셔요.",
        "ja": "コーヒーを飲みます。"
      },
      {
        "ko": "한국어를 공부해요.",
        "ja": "韓国語を勉強します。"
      }
    ]
  },
  {
    "id": "g-006",
    "level": 1,
    "pattern": "-아요 / -어요",
    "ja": "〜します・〜です（現在）",
    "explanation": "ヘヨ体の基本。語幹の母音がㅏ・ㅗ→아요、それ以外→어요、하다→해요。",
    "examples": [
      {
        "ko": "학교에 가요.",
        "ja": "学校に行きます。"
      },
      {
        "ko": "책을 읽어요.",
        "ja": "本を読みます。"
      },
      {
        "ko": "매일 운동해요.",
        "ja": "毎日運動します。"
      }
    ]
  },
  {
    "id": "g-007",
    "level": 1,
    "pattern": "-았어요 / -었어요",
    "ja": "〜しました（過去）",
    "explanation": "過去形。ㅏ・ㅗ→았어요、それ以外→었어요、하다→했어요。",
    "examples": [
      {
        "ko": "어제 친구를 만났어요.",
        "ja": "昨日友達に会いました。"
      },
      {
        "ko": "영화를 봤어요.",
        "ja": "映画を見ました。"
      },
      {
        "ko": "많이 먹었어요.",
        "ja": "たくさん食べました。"
      }
    ]
  },
  {
    "id": "g-008",
    "level": 1,
    "pattern": "-고 싶다",
    "ja": "〜したい",
    "explanation": "動詞の語幹＋고 싶다で希望を表します。",
    "examples": [
      {
        "ko": "한국에 가고 싶어요.",
        "ja": "韓国に行きたいです。"
      },
      {
        "ko": "떡볶이를 먹고 싶어요.",
        "ja": "トッポッキが食べたいです。"
      },
      {
        "ko": "뭐 하고 싶어?",
        "ja": "何したい？"
      }
    ]
  },
  {
    "id": "g-009",
    "level": 1,
    "pattern": "안 - / -지 않다",
    "ja": "〜しない・〜くない",
    "explanation": "否定形。「안＋動詞」が会話的、「-지 않다」は少しかたい言い方。",
    "examples": [
      {
        "ko": "오늘은 안 가요.",
        "ja": "今日は行きません。"
      },
      {
        "ko": "맵지 않아요.",
        "ja": "辛くないです。"
      },
      {
        "ko": "술을 안 마셔요.",
        "ja": "お酒を飲みません。"
      }
    ]
  },
  {
    "id": "g-010",
    "level": 1,
    "pattern": "-에",
    "ja": "〜に（場所・時間）",
    "explanation": "存在の場所、行き先、時間を表す助詞。",
    "examples": [
      {
        "ko": "집에 있어요.",
        "ja": "家にいます。"
      },
      {
        "ko": "7시에 일어나요.",
        "ja": "7時に起きます。"
      },
      {
        "ko": "서울에 가요.",
        "ja": "ソウルに行きます。"
      }
    ]
  },
  {
    "id": "g-011",
    "level": 1,
    "pattern": "-에서",
    "ja": "〜で / 〜から",
    "explanation": "動作をする場所、または出発点を表す助詞。",
    "examples": [
      {
        "ko": "카페에서 공부해요.",
        "ja": "カフェで勉強します。"
      },
      {
        "ko": "집에서 쉬어요.",
        "ja": "家で休みます。"
      },
      {
        "ko": "일본에서 왔어요.",
        "ja": "日本から来ました。"
      }
    ]
  },
  {
    "id": "g-012",
    "level": 1,
    "pattern": "-도",
    "ja": "〜も",
    "explanation": "「〜も」を表す助詞。",
    "examples": [
      {
        "ko": "저도 좋아요.",
        "ja": "私もいいです。"
      },
      {
        "ko": "커피도 마셔요.",
        "ja": "コーヒーも飲みます。"
      },
      {
        "ko": "내일도 와요?",
        "ja": "明日も来ますか？"
      }
    ]
  },
  {
    "id": "g-013",
    "level": 1,
    "pattern": "-하고 / -와・과",
    "ja": "〜と",
    "explanation": "「〜と」。하고は会話的。와（パッチムなし）・과（あり）は書き言葉的。",
    "examples": [
      {
        "ko": "친구하고 영화를 봤어요.",
        "ja": "友達と映画を見ました。"
      },
      {
        "ko": "빵과 우유를 샀어요.",
        "ja": "パンと牛乳を買いました。"
      },
      {
        "ko": "엄마하고 통화했어요.",
        "ja": "母と電話しました。"
      }
    ]
  },
  {
    "id": "g-014",
    "level": 1,
    "pattern": "-(으)세요",
    "ja": "〜してください / 〜されます",
    "explanation": "ていねいな命令・尊敬。パッチムあり→으세요。",
    "examples": [
      {
        "ko": "여기 앉으세요.",
        "ja": "ここに座ってください。"
      },
      {
        "ko": "잠깐만 기다리세요.",
        "ja": "少々お待ちください。"
      },
      {
        "ko": "안녕히 주무세요.",
        "ja": "おやすみなさい。"
      }
    ]
  },
  {
    "id": "g-015",
    "level": 1,
    "pattern": "-고",
    "ja": "〜して（並列・順序）",
    "explanation": "二つの動作や状態をつなぎます。",
    "examples": [
      {
        "ko": "밥을 먹고 학교에 가요.",
        "ja": "ご飯を食べて学校に行きます。"
      },
      {
        "ko": "이 집은 싸고 맛있어요.",
        "ja": "この店は安くておいしいです。"
      },
      {
        "ko": "샤워하고 잘게요.",
        "ja": "シャワーを浴びて寝ます。"
      }
    ]
  },
  {
    "id": "g-016",
    "level": 2,
    "pattern": "-(으)ㄹ 거예요",
    "ja": "〜するつもりです・〜でしょう",
    "explanation": "未来の予定や推測を表します。",
    "examples": [
      {
        "ko": "주말에 쇼핑할 거예요.",
        "ja": "週末に買い物するつもりです。"
      },
      {
        "ko": "내일은 비가 올 거예요.",
        "ja": "明日は雨が降るでしょう。"
      },
      {
        "ko": "뭐 먹을 거예요?",
        "ja": "何を食べるつもりですか？"
      }
    ]
  },
  {
    "id": "g-017",
    "level": 2,
    "pattern": "-(으)ㄹ 수 있다 / 없다",
    "ja": "〜できる / できない",
    "explanation": "可能・不可能を表します。",
    "examples": [
      {
        "ko": "한국어를 읽을 수 있어요.",
        "ja": "韓国語が読めます。"
      },
      {
        "ko": "오늘은 갈 수 없어요.",
        "ja": "今日は行けません。"
      },
      {
        "ko": "수영할 수 있어?",
        "ja": "泳げる？"
      }
    ]
  },
  {
    "id": "g-018",
    "level": 2,
    "pattern": "-아서 / -어서",
    "ja": "〜して・〜なので",
    "explanation": "理由や動作の順序を表します。後ろに命令・勧誘は使えません。",
    "examples": [
      {
        "ko": "배가 고파서 라면을 먹었어요.",
        "ja": "お腹がすいてラーメンを食べました。"
      },
      {
        "ko": "늦어서 미안해요.",
        "ja": "遅れてごめんなさい。"
      },
      {
        "ko": "만나서 반가워요.",
        "ja": "会えてうれしいです。"
      }
    ]
  },
  {
    "id": "g-019",
    "level": 2,
    "pattern": "-(으)니까",
    "ja": "〜だから",
    "explanation": "理由・根拠。後ろに命令や勧誘も使えます。",
    "examples": [
      {
        "ko": "비가 오니까 우산을 가져가세요.",
        "ja": "雨が降っているから傘を持って行ってください。"
      },
      {
        "ko": "시간이 없으니까 빨리 가자.",
        "ja": "時間がないから早く行こう。"
      },
      {
        "ko": "추우니까 문 닫아 줘.",
        "ja": "寒いからドア閉めて。"
      }
    ]
  },
  {
    "id": "g-020",
    "level": 2,
    "pattern": "-지만",
    "ja": "〜けれど",
    "explanation": "逆接。前と後ろの内容が反対のときに使います。",
    "examples": [
      {
        "ko": "비싸지만 맛있어요.",
        "ja": "高いけどおいしいです。"
      },
      {
        "ko": "한국어는 어렵지만 재미있어요.",
        "ja": "韓国語は難しいけど楽しいです。"
      },
      {
        "ko": "피곤하지만 괜찮아요.",
        "ja": "疲れているけど大丈夫です。"
      }
    ]
  },
  {
    "id": "g-021",
    "level": 2,
    "pattern": "-(으)면",
    "ja": "〜したら・〜すれば",
    "explanation": "条件・仮定を表します。",
    "examples": [
      {
        "ko": "시간이 있으면 같이 가요.",
        "ja": "時間があれば一緒に行きましょう。"
      },
      {
        "ko": "도착하면 연락해.",
        "ja": "着いたら連絡して。"
      },
      {
        "ko": "비가 오면 집에 있을 거예요.",
        "ja": "雨が降ったら家にいます。"
      }
    ]
  },
  {
    "id": "g-022",
    "level": 2,
    "pattern": "-(으)러 가다",
    "ja": "〜しに行く",
    "explanation": "移動の目的を表します。後ろは가다・오다など移動の動詞。",
    "examples": [
      {
        "ko": "밥 먹으러 가요.",
        "ja": "ご飯を食べに行きます。"
      },
      {
        "ko": "옷을 사러 명동에 갔어요.",
        "ja": "服を買いに明洞へ行きました。"
      },
      {
        "ko": "놀러 와!",
        "ja": "遊びに来て！"
      }
    ]
  },
  {
    "id": "g-023",
    "level": 2,
    "pattern": "-아 / -어 주세요",
    "ja": "〜してください（お願い）",
    "explanation": "相手に何かを頼むていねいな表現。",
    "examples": [
      {
        "ko": "사진 좀 찍어 주세요.",
        "ja": "写真を撮ってください。"
      },
      {
        "ko": "천천히 말해 주세요.",
        "ja": "ゆっくり話してください。"
      },
      {
        "ko": "문 좀 열어 주세요.",
        "ja": "ドアを開けてください。"
      }
    ]
  },
  {
    "id": "g-024",
    "level": 2,
    "pattern": "-아도 / -어도 되다",
    "ja": "〜してもいい",
    "explanation": "許可を求めたり与えたりします。",
    "examples": [
      {
        "ko": "여기 앉아도 돼요?",
        "ja": "ここに座ってもいいですか？"
      },
      {
        "ko": "사진 찍어도 돼요?",
        "ja": "写真を撮ってもいいですか？"
      },
      {
        "ko": "내일 와도 돼.",
        "ja": "明日来てもいいよ。"
      }
    ]
  },
  {
    "id": "g-025",
    "level": 2,
    "pattern": "-(으)면 안 되다",
    "ja": "〜してはいけない",
    "explanation": "禁止を表します。",
    "examples": [
      {
        "ko": "여기서 담배를 피우면 안 돼요.",
        "ja": "ここでたばこを吸ってはいけません。"
      },
      {
        "ko": "늦으면 안 돼.",
        "ja": "遅れちゃだめだよ。"
      },
      {
        "ko": "사진을 찍으면 안 돼요.",
        "ja": "写真を撮ってはいけません。"
      }
    ]
  },
  {
    "id": "g-026",
    "level": 2,
    "pattern": "-고 있다",
    "ja": "〜している（進行）",
    "explanation": "動作が進行中であることを表します。",
    "examples": [
      {
        "ko": "지금 밥 먹고 있어요.",
        "ja": "今ご飯を食べています。"
      },
      {
        "ko": "한국어를 배우고 있어요.",
        "ja": "韓国語を習っています。"
      },
      {
        "ko": "뭐 하고 있어?",
        "ja": "何してる？"
      }
    ]
  },
  {
    "id": "g-027",
    "level": 2,
    "pattern": "-(으)ㄹ까요?",
    "ja": "〜しましょうか？",
    "explanation": "提案したり、相手の意見を聞いたりします。",
    "examples": [
      {
        "ko": "같이 갈까요?",
        "ja": "一緒に行きましょうか？"
      },
      {
        "ko": "뭐 먹을까?",
        "ja": "何食べようか？"
      },
      {
        "ko": "창문을 열까요?",
        "ja": "窓を開けましょうか？"
      }
    ]
  },
  {
    "id": "g-028",
    "level": 2,
    "pattern": "-(으)ㄹ게요",
    "ja": "〜しますね（意志・約束）",
    "explanation": "話し手の意志や約束を相手に伝えます。",
    "examples": [
      {
        "ko": "제가 할게요.",
        "ja": "私がやりますね。"
      },
      {
        "ko": "이따 전화할게.",
        "ja": "あとで電話するね。"
      },
      {
        "ko": "이걸로 할게요.",
        "ja": "これにします。"
      }
    ]
  },
  {
    "id": "g-029",
    "level": 3,
    "pattern": "-(으)ㄴ / -는 것 같다",
    "ja": "〜みたいだ・〜と思う",
    "explanation": "推測や、やわらかい意見を表します。",
    "examples": [
      {
        "ko": "비가 오는 것 같아요.",
        "ja": "雨が降っているみたいです。"
      },
      {
        "ko": "그 사람 화난 것 같아.",
        "ja": "あの人怒ってるみたい。"
      },
      {
        "ko": "이게 더 좋은 것 같아요.",
        "ja": "こっちのほうがいいと思います。"
      }
    ]
  },
  {
    "id": "g-030",
    "level": 3,
    "pattern": "-기 때문에",
    "ja": "〜ため・〜ので",
    "explanation": "はっきりした理由を表すややかたい表現。名詞には「때문에」。",
    "examples": [
      {
        "ko": "길이 막히기 때문에 지하철을 타요.",
        "ja": "道が混んでいるので地下鉄に乗ります。"
      },
      {
        "ko": "감기 때문에 학교에 못 갔어요.",
        "ja": "風邪のため学校に行けませんでした。"
      },
      {
        "ko": "시험이 있기 때문에 바빠요.",
        "ja": "試験があるので忙しいです。"
      }
    ]
  },
  {
    "id": "g-031",
    "level": 3,
    "pattern": "-는데 / -(으)ㄴ데",
    "ja": "〜けど・〜なんだけど",
    "explanation": "前置きや状況説明、軽い逆接に使います。",
    "examples": [
      {
        "ko": "배고픈데 뭐 먹을까?",
        "ja": "お腹すいたけど何食べる？"
      },
      {
        "ko": "지금 가는데 같이 갈래?",
        "ja": "今から行くんだけど一緒に行く？"
      },
      {
        "ko": "비싼데 정말 예뻐요.",
        "ja": "高いけど本当にかわいいです。"
      }
    ]
  },
  {
    "id": "g-032",
    "level": 3,
    "pattern": "-게 되다",
    "ja": "〜することになる・〜ようになる",
    "explanation": "状況の変化や、自分の意志ではない決定を表します。",
    "examples": [
      {
        "ko": "한국에서 일하게 됐어요.",
        "ja": "韓国で働くことになりました。"
      },
      {
        "ko": "김치를 먹을 수 있게 됐어요.",
        "ja": "キムチが食べられるようになりました。"
      },
      {
        "ko": "다음 달에 이사하게 됐어요.",
        "ja": "来月引っ越すことになりました。"
      }
    ]
  },
  {
    "id": "g-033",
    "level": 3,
    "pattern": "-아야 / -어야 하다",
    "ja": "〜しなければならない",
    "explanation": "義務を表します。会話では「-아야 돼요」もよく使います。",
    "examples": [
      {
        "ko": "내일 일찍 일어나야 해요.",
        "ja": "明日早く起きなければなりません。"
      },
      {
        "ko": "숙제를 해야 돼.",
        "ja": "宿題をしなきゃ。"
      },
      {
